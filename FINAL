// ==================================================
// PROCESS CLASS
// ==================================================
class Process {
    int pid;
    int arrivalTime;
    int burstTime;
    int queueLevel;

    Process(int pid, int at, int bt, int queue) {
        this.pid = pid;
        this.arrivalTime = at;
        this.burstTime = bt;
        this.queueLevel = queue;
    }
}

// ==================================================
// GANTT SEGMENT
// ==================================================
class Segment {
    int pid;
    int start;
    int end;

    Segment(int pid, int start, int end) {
        this.pid = pid;
        this.start = start;
        this.end = end;
    }
}

// ==================================================
// PROCESS STATISTICS
// ==================================================
class Stats {
    int firstStart = -1;
    int completion = 0;
}

class ScheduleResult {
    ArrayList<Segment> gantt = new ArrayList<>();
    LinkedHashMap<Integer, Stats> stats = new LinkedHashMap<>();
    int finishTime;
}

// ==================================================
// GRAPHICAL GANTT CHART
// ==================================================
class GanttChart extends JPanel {

    private ArrayList<Segment> segments = new ArrayList<>();

    private final int scale = 55;
    private final int left = 55;

    GanttChart() {
        setBackground(Color.WHITE);
        setBorder(new EmptyBorder(10, 10, 10, 10));
        setPreferredSize(new Dimension(700, 145));
    }

    public void setSegments(List<Segment> data) {

        segments = new ArrayList<>(data);

        int finish = 0;

        for (Segment s : segments) {
            finish = Math.max(finish, s.end);
        }

        int width = left + finish * scale + 80;

        setPreferredSize(
            new Dimension(Math.max(width, 700), 145)
        );

        revalidate();
        repaint();
    }

    @Override
    protected void paintComponent(Graphics g) {

        super.paintComponent(g);

        Graphics2D g2 = (Graphics2D) g.create();

        g2.setRenderingHint(
            RenderingHints.KEY_ANTIALIASING,
            RenderingHints.VALUE_ANTIALIAS_ON
        );

        g2.setFont(new Font("Arial", Font.BOLD, 13));

        if (segments.isEmpty()) {

            g2.setColor(Color.GRAY);

            g2.drawString(
                "Run an algorithm to display the Gantt Chart.",
                30, 60
            );

            g2.dispose();
            return;
        }

        g2.setColor(Color.BLACK);

        g2.drawString(
            "CPU EXECUTION TIMELINE",
            left, 20
        );

        int y = 35;
        int barHeight = 48;

        for (Segment s : segments) {

            int x = left + s.start * scale;

            int width = Math.max(
                1, (s.end - s.start) * scale
            );

            Color processColor;

            if (s.pid == -1) {

                processColor = new Color(190, 190, 190);

            } else {

                processColor = Color.getHSBColor(
                    (s.pid * 0.137f) % 1.0f,
                    0.65f,
                    0.85f
                );
            }

            g2.setColor(processColor);

            g2.fillRoundRect(
                x, y, width, barHeight, 9, 9
            );

            g2.setColor(Color.BLACK);

            g2.drawRoundRect(
                x, y, width, barHeight, 9, 9
            );

            String label = s.pid == -1
                ? "IDLE"
                : "P" + s.pid;

            FontMetrics fm = g2.getFontMetrics();

            if (width > fm.stringWidth(label) + 8) {

                int textX = x +
                    (width - fm.stringWidth(label)) / 2;

                int textY = y +
                    (barHeight + fm.getAscent()) / 2 - 3;

                g2.drawString(label, textX, textY);
            }

            // Starting time
            g2.drawString(
                String.valueOf(s.start),
                x - 4,
                y + barHeight + 20
            );
        }

        // Final ending time
        int finalTime = segments.get(
            segments.size() - 1
        ).end;

        int finalX = left + finalTime * scale;

        g2.drawString(
            String.valueOf(finalTime),
            finalX - 4,
            y + barHeight + 20
        );

        g2.dispose();
    }
}

