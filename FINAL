    // ==================================================
    // ADD PROCESS
    // ==================================================
    private void addProcess() {

        try {

            int pid = Integer.parseInt(
                pidField.getText().trim()
            );

            int at = Integer.parseInt(
                atField.getText().trim()
            );

            int bt = Integer.parseInt(
                btField.getText().trim()
            );

            int queue = Integer.parseInt(
                queueField.getText().trim()
            );

            if (pid < 0 || at < 0 ||
             bt <= 0) {

                throw new IllegalArgumentException(
                    "PID and arrival time must be nonnegative. Burst time must be positive."
                );
            }

            if (queue < 1 || queue > 4) {

                throw new IllegalArgumentException(
                    "Queue level must be between 1 and 4."
                );
            }

            for (Process p : processes) {

                if (p.pid == pid) {

                    throw new IllegalArgumentException(
                        "Process ID already exists!"
                    );
                }
            }

            processes.add(
                new Process(pid, at, bt, queue)
            );

            outputArea.append(
                "P" + pid + " Added Successfully!\n"
            );

            pidField.setText("");
            atField.setText("");
            btField.setText("");

            pidField.requestFocus();

        } catch (NumberFormatException ex) {

            JOptionPane.showMessageDialog(
                this,
                "Please enter valid whole numbers in all process fields.",
                "Invalid Input",
                JOptionPane.ERROR_MESSAGE
            );

        } catch (IllegalArgumentException ex) {

            JOptionPane.showMessageDialog(
                this,
                ex.getMessage(),
                "Input Error",
                JOptionPane.ERROR_MESSAGE
            );
        }
    }

    // ==================================================
    // RUN SIMULATION
    // ==================================================
    private void runSimulation() {

        if (processes.isEmpty()) {

            JOptionPane.showMessageDialog(
                this,
                "Please add at least one process."
            );

            return;
        }

        String algorithm =
            algorithmBox.getSelectedItem().toString();

        int quantum = 1;

        if (algorithm.equals("RR") ||
            algorithm.equals("MLQ")) {

            try {

                quantum = Integer.parseInt(
                    quantumField.getText().trim()
                );

                if (quantum <= 0) {
                    throw new NumberFormatException();
                }

            } catch (NumberFormatException ex) {

                JOptionPane.showMessageDialog(
                    this,
                    "Time Quantum must be a positive whole number."
                );

                return;
            }
        }

        outputArea.setText("");

        ScheduleResult result;

        switch (algorithm) {

            case "FCFS":
                result = runFCFS(processes, 0);
                break;

            case "SJF":
                result = runSJF(processes, 0);
                break;

            case "SRTF":
                result = runSRTF(processes, 0);
                break;

            case "RR":
                result = runRR(processes, quantum, 0);
                break;

            case "MLQ":
                result = runMLQ(processes, quantum);
                break;

            default:
                return;
        }

        ganttChart.setSegments(result.gantt);

        displayResults(result, algorithm);
    }

    // ==================================================
    // FCFS - NON PREEMPTIVE
    // ==================================================
    private ScheduleResult runFCFS(
        List<Process> list,
        int initialTime
    ) {

        ScheduleResult result = new ScheduleResult();

        ArrayList<Process> sorted =
            new ArrayList<>(list);

        sorted.sort(
            Comparator.comparingInt(
                p -> p.arrivalTime
            )
        );

        int time = initialTime;

        for (Process p : sorted) {

            if (time < p.arrivalTime) {

                addSegment(
                    result, -1, time, p.arrivalTime
                );

                time = p.arrivalTime;
            }

            int start = time;

            time += p.burstTime;

            addSegment(
                result, p.pid, start, time
            );

            Stats s = new Stats();

            s.firstStart = start;
            s.completion = time;

            result.stats.put(p.pid, s);
        }

        result.finishTime = time;

        return result;
    }

    // ==================================================
    // SJF - NON PREEMPTIVE
    // ==================================================
    private ScheduleResult runSJF(
        List<Process> list,
        int initialTime
    ) {

        ScheduleResult result = new ScheduleResult();

        ArrayList<Process> remaining =
            new ArrayList<>(list);

        int time = initialTime;

        while (!remaining.isEmpty()) {

            Process selected = null;

            for (Process p : remaining) {

                if (p.arrivalTime <= time) {

                    if (selected == null ||
                        p.burstTime < selected.burstTime ||
                        (p.burstTime == selected.burstTime &&
                         p.arrivalTime < selected.arrivalTime)) {

                        selected = p;
                    }
                }
            }

            if (selected == null) {

                int nextArrival = Integer.MAX_VALUE;

                for (Process p : remaining) {

                    nextArrival = Math.min(
                        nextArrival,
                        p.arrivalTime
                    );
                }

                addSegment(
                    result, -1, time, nextArrival
                );

                time = nextArrival;

                continue;
            }

            int start = time;

            time += selected.burstTime;

            addSegment(
                result, selected.pid, start, time
            );

            Stats s = new Stats();

            s.firstStart = start;
            s.completion = time;

            result.stats.put(selected.pid, s);

            remaining.remove(selected);
        }

        result.finishTime = time;

        return result;
    }

    // ==================================================
    // SRTF - PREEMPTIVE
    // ==================================================
    private ScheduleResult runSRTF(
        List<Process> list,
        int initialTime
    ) {

        ScheduleResult result = new ScheduleResult();

        HashMap<Integer, Integer> remaining =
            new HashMap<>();

        for (Process p : list) {

            remaining.put(
                p.pid,
                p.burstTime
            );

            result.stats.put(
                p.pid,
                new Stats()
            );
        }

        int time = initialTime;
        int completed = 0;

        while (completed < list.size()) {

            Process selected = null;

            for (Process p : list) {

                if (p.arrivalTime <= time &&
                    remaining.get(p.pid) > 0) {

                    if (selected == null ||
                        remaining.get(p.pid) <
                        remaining.get(selected.pid)) {

                        selected = p;
                    }
                }
            }

            if (selected == null) {

                addSegment(
                    result, -1, time, time + 1
                );

                time++;

                continue;
            }

            Stats s = result.stats.get(
                selected.pid
            );

            if (s.firstStart == -1) {
                s.firstStart = time;
            }

            int start = time;

            time++;

            remaining.put(
                selected.pid,
                remaining.get(selected.pid) - 1
            );

            addSegment(
                result, selected.pid, start, time
            );

            if (remaining.get(selected.pid) == 0) {

                s.completion = time;

                completed++;
            }
        }

        result.finishTime = time;

        return result;
    }

    // ==================================================
    // ROUND ROBIN - PREEMPTIVE
    // ==================================================
    private ScheduleResult runRR(
        List<Process> list,
        int quantum,
        int initialTime
    ) {

        ScheduleResult result = new ScheduleResult();

        ArrayList<Process> sorted =
            new ArrayList<>(list);

        sorted.sort(
            Comparator.comparingInt(
                p -> p.arrivalTime
            )
        );

        HashMap<Integer, Integer> remaining =
            new HashMap<>();

        for (Process p : list) {

            remaining.put(
                p.pid,
                p.burstTime
            );

            result.stats.put(
                p.pid,
                new Stats()
            );
        }

        Queue<Process> ready =
            new LinkedList<>();

        int time = initialTime;
        int index = 0;
        int completed = 0;

        while (completed < list.size()) {

            while (index < sorted.size() &&
                   sorted.get(index).arrivalTime <= time) {

                ready.add(sorted.get(index));

                index++;
            }

            if (ready.isEmpty()) {

                if (index < sorted.size()) {

                    int next = Math.max(
                        time,
                        sorted.get(index).arrivalTime
                    );

                    addSegment(
                        result, -1, time, next
                    );

                    time = next;
                }

                continue;
            }

            Process current = ready.poll();

            Stats s = result.stats.get(
                current.pid
            );

            if (s.firstStart == -1) {
                s.firstStart = time;
            }

            int runTime = Math.min(
                quantum,
                remaining.get(current.pid)
            );

            int start = time;

            time += runTime;

            remaining.put(
                current.pid,
                remaining.get(current.pid) - runTime
            );

            addSegment(
                result, current.pid, start, time
            );

            while (index < sorted.size() &&
                   sorted.get(index).arrivalTime <= time) {

                ready.add(sorted.get(index));

                index++;
            }

            if (remaining.get(current.pid) > 0) {

                ready.add(current);

            } else {

                s.completion = time;

                completed++;
            }
        }

        result.finishTime = time;

        return result;
    }

    // ==================================================
    // MLQ - MULTILEVEL QUEUE
    //
    // QUEUE 1 = FCFS
    // QUEUE 2 = SJF
    // QUEUE 3 = SRTF
    // QUEUE 4 = ROUND ROBIN
    // ==================================================
    private ScheduleResult runMLQ(
        List<Process> list,
        int quantum
    ) {

        ScheduleResult combined =
            new ScheduleResult();

        int currentTime = 0;

        String[] algorithms = {
            "FCFS",
            "SJF",
            "SRTF",
            "RR"
        };

        outputArea.append(
            "\n========== MULTILEVEL QUEUE ==========\n"
        );

        for (int q = 1; q <= 4; q++) {

            ArrayList<Process> queueProcesses =
                new ArrayList<>();

            for (Process p : list) {

                if (p.queueLevel == q) {

                    queueProcesses.add(p);
                }
            }

            outputArea.append(
                "\nQUEUE " + q +
                " - " + algorithms[q - 1] + "\n"
            );

            if (queueProcesses.isEmpty()) {

                outputArea.append(
                    "No processes in this queue.\n"
                );

                continue;
            }

            ScheduleResult part;

            switch (q) {

                case 1:
                    part = runFCFS(
                        queueProcesses,
                        currentTime
                    );
                    break;

                case 2:
                    part = runSJF(
                        queueProcesses,
                        currentTime
                    );
                    break;

                case 3:
                    part = runSRTF(
                        queueProcesses,
                        currentTime
                    );
                    break;

                default:
                    part = runRR(
                        queueProcesses,
                        quantum,
                        currentTime
                    );
                    break;
            }

            combined.gantt.addAll(
                part.gantt
            );

            combined.stats.putAll(
                part.stats
            );

            currentTime = part.finishTime;
        }

        combined.finishTime = currentTime;

        return combined;
    }

    // ==================================================
    // ADD GANTT SEGMENT
    // ==================================================
    private void addSegment(
        ScheduleResult result,
        int pid,
        int start,
        int end
    ) {

        if (end <= start) {
            return;
        }

        if (!result.gantt.isEmpty()) {

            Segment last = result.gantt.get(
                result.gantt.size() - 1
            );

            if (last.pid == pid &&
                last.end == start) {

                last.end = end;

                return;
            }
        }

        result.gantt.add(
            new Segment(pid, start, end)
        );
    }

    // ==================================================
    // DISPLAY RESULTS
    // ==================================================
    private void displayResults(
        ScheduleResult result,
        String algorithm
    ) {

        outputArea.append(
            "\n========== " +
            algorithm +
            " RESULTS ==========\n"
        );

        outputArea.append(
            "\nGANTT TIMELINE:\n"
        );

        for (Segment s : result.gantt) {

            String label = s.pid == -1
                ? "IDLE"
                : "P" + s.pid;

            outputArea.append(
                "|" + label +
                " (" + s.start +
                "-" + s.end + ") "
            );
        }

        outputArea.append("|\n\n");

        outputArea.append(
            String.format(
                "%-8s %-8s %-8s %-8s %-8s %-8s\n",
                "PID", "AT", "BT", "CT", "TAT", "WT"
            )
        );

        outputArea.append(
            "------------------------------------------------------------\n"
        );

        double totalTAT = 0;
        double totalWT = 0;

        for (Process p : processes) {

            Stats s = result.stats.get(p.pid);

            if (s == null) {
                continue;
            }

            int tat =
                s.completion - p.arrivalTime;

            int wt =
                tat - p.burstTime;

            totalTAT += tat;
            totalWT += wt;

            outputArea.append(
                String.format(
                    "%-8d %-8d %-8d %-8d %-8d %-8d\n",
                    p.pid,
                    p.arrivalTime,
                    p.burstTime,
                    s.completion,
                    tat,
                    wt
                )
            );
        }

        int count = result.stats.size();

        if (count > 0) {

            outputArea.append(
                "\nAverage Turnaround Time: " +
                String.format(
                    "%.2f",
                    totalTAT / count
                )
            );

            outputArea.append(
                "\nAverage Waiting Time: " +
                String.format(
                    "%.2f",
                    totalWT / count
                )
            );
        }

        outputArea.append(
            "\n\nSIMULATION COMPLETED!\n"
        );
    }

